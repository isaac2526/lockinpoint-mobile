<?xml version="1.0" encoding="utf-8"?>
<!--
  THE MARK, CENTRED, ON THE APP'S OWN BACKGROUND.

  This file shipped as the Flutter template left it: a white rectangle with
  the bitmap commented out. Nothing was centred on it because nothing was on
  it. android:gravity="center" is what actually puts the mark in the middle of
  the window, at every screen size, before a single line of Dart has run.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/lipSurface" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
